module machine_esp

import testing

fn test_rmt_symbol_pack() {
    // d0=3 l0=1 d1=9 l1=0 → 0x00098003
    testing.assert_eq_i32(rmt_symbol(3, 1, 9, 0), 622595)
    // d0=9 l0=1 d1=3 l1=0 → 0x00038009
    testing.assert_eq_i32(rmt_symbol(9, 1, 3, 0), 229385)
    testing.assert_eq_i32(rmt_symbol(0, 0, 0, 0), 0)
}

fn test_rmt_mem_base_s3() {
    testing.assert_eq_i32(rmt_mem_base_s3(0), 0x60016800)
    testing.assert_eq_i32(rmt_mem_base_s3(1), 0x600168C0)
    testing.assert_eq_i32(rmt_mem_base_s3(3), 0x60016A40)
}

fn test_rmt_sig_out_s3() {
    testing.assert_eq_i32(rmt_sig_out_s3(0), 81)
    testing.assert_eq_i32(rmt_sig_out_s3(3), 84)
}

fn test_rmt_tick_hz_s3() {
    testing.assert_eq_i32(rmt_tick_hz_s3(80000000, 8), 10000000)
    testing.assert_eq_i32(rmt_tick_hz_s3(80000000, 1), 80000000)
}
