/// ESP32-S3 UART (MMIO). Twin of `uart_out` — call `uart_out_s3`.
/// Instances 0/1/2. Signal IDs: UART0=12, UART1=15, UART2=18.
/// SYSTEM clocks: PERIP_CLK_EN0 @ +0x18; UART2 uses PERIP_CLK_EN1 @ +0x1C.
module machine_esp

fn uart_base_s3(uart: i32): i32 {
    if uart == 1 {
        return 0x60010000
    }
    if uart == 2 {
        return 0x6002E000
    }
    return 0x60000000
}

fn uart_sig_s3(uart: i32): i32 {
    if uart == 1 {
        return 15
    }
    if uart == 2 {
        return 18
    }
    return 12
}

fn uart_enable_clock_s3(uart: i32) {
    let clk_en0 = cast(*mut volatile i32, 0x600C0018)
    let rst_en0 = cast(*mut volatile i32, 0x600C0020)
    // UART_MEM bit 24
    *clk_en0 = *clk_en0 | (1 << 24)
    *rst_en0 = *rst_en0 & ~(1 << 24)
    if uart == 2 {
        let clk_en1 = cast(*mut volatile i32, 0x600C001C)
        let rst_en1 = cast(*mut volatile i32, 0x600C0024)
        *clk_en1 = *clk_en1 | (1 << 9)
        *rst_en1 = *rst_en1 | (1 << 9)
        *rst_en1 = *rst_en1 & ~(1 << 9)
        return
    }
    if uart == 1 {
        *clk_en0 = *clk_en0 | (1 << 5)
        *rst_en0 = *rst_en0 | (1 << 5)
        *rst_en0 = *rst_en0 & ~(1 << 5)
        return
    }
    // UART0 bit 2
    *clk_en0 = *clk_en0 | (1 << 2)
    *rst_en0 = *rst_en0 | (1 << 2)
    *rst_en0 = *rst_en0 & ~(1 << 2)
}

/// Configure UART `uart` (0/1/2) on TX/RX GPIOs. 8N1, APB sclk (`SCLK_SEL=1`).
pub fn uart_out_s3(uart: i32, tx: i32, rx: i32, uart_clk_hz: i32, baud: i32): Uart {
    let mut u = uart
    if u != 1 {
        if u != 2 {
            u = 0
        }
    }
    uart_enable_clock_s3(u)
    let sig = uart_sig_s3(u)
    matrix_out_s3(tx, sig)
    matrix_in_s3(rx, sig)

    let base = uart_base_s3(u)
    let fifo = cast(*mut volatile i32, base)
    let clkdiv = cast(*mut volatile i32, base + 0x14)
    let status = cast(*mut volatile i32, base + 0x1C)
    let conf0 = cast(*mut volatile i32, base + 0x20)
    let clk_conf = cast(*mut volatile i32, base + 0x78)
    let id = cast(*mut volatile i32, base + 0x80)

    *clk_conf = (1 << 22) | (1 << 24) | (1 << 25) | (1 << 20)
    let div_int = uart_clkdiv_int(uart_clk_hz, baud)
    let frag = uart_clkdiv_frag(uart_clk_hz, baud)
    *clkdiv = (div_int & 4095) | ((frag & 15) << 20)
    *conf0 = (3 << 2) | (1 << 4) | (1 << 17) | (1 << 18)
    *conf0 = (3 << 2) | (1 << 4)
    *id = *id | (1 << 31)
    while (*id & (1 << 31)) != 0 {
    }

    return Uart{ fifo: fifo, status: status, conf0: conf0, clk_conf: clk_conf }
}
