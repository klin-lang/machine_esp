module machine_esp

import testing

fn test_adc_p4_gpio_for_channel() {
    testing.assert_eq_i32(adc_p4_gpio_for_channel(0), 16)
    testing.assert_eq_i32(adc_p4_gpio_for_channel(7), 23)
    testing.assert_eq_i32(adc_p4_gpio_for_channel(0 - 1), 0 - 1)
    testing.assert_eq_i32(adc_p4_gpio_for_channel(8), 0 - 1)
}

fn test_adc_p4_bases() {
    testing.assert_eq_i32(adc_p4_lp_base(), 0x50127000)
    testing.assert_eq_i32(adc_p4_lpperi_base(), 0x50120000)
}

fn test_adc2_p4_gpio_for_channel() {
    testing.assert_eq_i32(adc2_p4_gpio_for_channel(0), 49)
    testing.assert_eq_i32(adc2_p4_gpio_for_channel(5), 54)
    testing.assert_eq_i32(adc2_p4_gpio_for_channel(0 - 1), 0 - 1)
    testing.assert_eq_i32(adc2_p4_gpio_for_channel(6), 0 - 1)
}

fn test_adc2_p4_hw_pad() {
    testing.assert_eq_i32(adc2_p4_hw_pad(0), 2)
    testing.assert_eq_i32(adc2_p4_hw_pad(5), 7)
    testing.assert_eq_i32(adc2_p4_hw_pad(0 - 1), 0 - 1)
    testing.assert_eq_i32(adc2_p4_hw_pad(6), 0 - 1)
}
