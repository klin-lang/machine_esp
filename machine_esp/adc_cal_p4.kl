/// ESP32-P4 SAR regi2c (MMIO). Analog I2C slave `I2C_SAR_ADC=0x69`.
/// Master is **LP_I2C_ANA_MST** `0x50124000` (not C3/S3 I2C_MST `0x6000E…`).
/// Call `adc_cal_init_p4` before `adc_out_p4` / `adc2_out_p4` when you want DREF.
/// No eFuse / curve-fitting / IDF `adc_cali_*` in this tag.
module machine_esp

/// 1 when `unit` is ADC1 (1) or ADC2 (2); else 0 (host-testable).
fn adc_cal_p4_unit_ok(unit: i32): i32 {
    if unit == 1 {
        return 1
    }
    if unit == 2 {
        return 1
    }
    return 0
}

/// LP_I2C_ANA_MST base (IDF `DR_REG_LP_I2C_ANA_MST_BASE`). Host-testable.
fn regi2c_p4_base(): i32 {
    return 0x50124000
}

fn regi2c_p4_ctrl_reg(): i32 {
    return 0x50124000
}

fn regi2c_p4_ana_conf1_reg(): i32 {
    return 0x5012401C
}

fn regi2c_p4_ana_conf2_reg(): i32 {
    return 0x50124020
}

fn regi2c_p4_clk160m_reg(): i32 {
    return 0x50124034
}

/// PMU RF_PWC (IDF `PMU_RF_PWC_REG`). Host-testable.
fn regi2c_p4_pmu_rf_pwc(): i32 {
    return 0x5011515C
}

/// Analog I2C slave for SAR (`I2C_SAR_ADC`). Host-testable.
fn regi2c_p4_sar_slave(): i32 {
    return 0x69
}

/// ANA_CONF2 `SAR_I2C_MST_SEL` bit. Host-testable.
fn regi2c_p4_sar_mst_sel(): i32 {
    return 1 << 7
}

/// Pack I2C0_CTRL command: slave[7:0] | addr[15:8] | data[23:16] | wr[24].
fn regi2c_p4_cmd(slave: i32, addr: i32, data: i32, write: i32): i32 {
    let mut c = slave & 255
    c = c | ((addr & 255) << 8)
    c = c | ((data & 255) << 16)
    if write != 0 {
        c = c | (1 << 24)
    }
    return c
}

/// Insert `val` into `old` at bits `[msb:lsb]` (host-testable).
fn regi2c_p4_mask_insert(old: i32, msb: i32, lsb: i32, val: i32): i32 {
    let width = (msb - lsb) + 1
    let mut mask = (1 << width) - 1
    mask = mask << lsb
    let mut v = old & ~mask
    v = v | ((val << lsb) & mask)
    return v
}

fn regi2c_p4_init_code_msb(code: i32): i32 {
    return (code >> 8) & 15
}

fn regi2c_p4_init_code_lsb(code: i32): i32 {
    return code & 255
}

fn regi2c_p4_sar1_dref_reg(): i32 {
    return 2
}

fn regi2c_p4_sar2_dref_reg(): i32 {
    return 5
}

fn regi2c_p4_encal_reg(): i32 {
    return 7
}

fn regi2c_wait_idle_p4() {
    let ctrl = cast(*mut volatile i32, regi2c_p4_ctrl_reg())
    while (*ctrl & (1 << 25)) != 0 {
    }
}

fn regi2c_sar_clock_enable_p4() {
    // LPPERI_CLK_EN — CK_EN_LP_I2CMST bit 27
    let peri = cast(*mut volatile i32, 0x50120000)
    *peri = *peri | (1 << 27)
    // LPPERI_RESET_EN — RST_EN_LP_I2CMST bit 26 (pulse)
    let rst = cast(*mut volatile i32, 0x50120008)
    *rst = *rst | (1 << 26)
    *rst = *rst & ~(1 << 26)
    // CLK160M — clk_i2c_mst_sel_160m bit 0
    let clk = cast(*mut volatile i32, regi2c_p4_clk160m_reg())
    *clk = *clk | 1
    // PMU RF_PWC: enter reset, XPD, release reset
    let pmu = cast(*mut volatile i32, regi2c_p4_pmu_rf_pwc())
    let mut p = *pmu
    p = p & ~(1 << 26)
    *pmu = p
    p = *pmu | (1 << 27)
    *pmu = p
    p = *pmu | (1 << 26)
    *pmu = p
    // Select SAR analog master (ANA_CONF2 bit 7)
    let conf1 = cast(*mut volatile i32, regi2c_p4_ana_conf1_reg())
    let conf2 = cast(*mut volatile i32, regi2c_p4_ana_conf2_reg())
    *conf1 = 0
    *conf2 = 0
    *conf2 = regi2c_p4_sar_mst_sel()
}

fn regi2c_sar_read_p4(reg: i32): i32 {
    regi2c_sar_clock_enable_p4()
    regi2c_wait_idle_p4()
    let ctrl = cast(*mut volatile i32, regi2c_p4_ctrl_reg())
    *ctrl = regi2c_p4_cmd(regi2c_p4_sar_slave(), reg, 0, 0)
    regi2c_wait_idle_p4()
    return (*ctrl >> 16) & 255
}

fn regi2c_sar_write_p4(reg: i32, val: i32) {
    regi2c_sar_clock_enable_p4()
    regi2c_wait_idle_p4()
    let ctrl = cast(*mut volatile i32, regi2c_p4_ctrl_reg())
    *ctrl = regi2c_p4_cmd(regi2c_p4_sar_slave(), reg, val, 1)
    regi2c_wait_idle_p4()
}

fn regi2c_sar_write_mask_p4(reg: i32, msb: i32, lsb: i32, val: i32) {
    let old = regi2c_sar_read_p4(reg)
    regi2c_sar_write_p4(reg, regi2c_p4_mask_insert(old, msb, lsb, val))
}

/// Set SAR1/SAR2 DREF=4 (IDF `adc_ll_calibration_init`). Explicit — not called by `adc_out_p4`.
pub fn adc_cal_init_p4() {
    // ADC_SAR1_DREF_ADDR 0x2 [6:4]
    regi2c_sar_write_mask_p4(2, 6, 4, 4)
    // ADC_SAR2_DREF_ADDR 0x5 [6:4]
    regi2c_sar_write_mask_p4(5, 6, 4, 4)
}

/// Write 12-bit initial code for ADC `unit` (1 or 2). Out of range → no MMIO.
pub fn adc_cal_init_code_p4(unit: i32, code: i32) {
    if adc_cal_p4_unit_ok(unit) == 0 {
        return
    }
    let msb = regi2c_p4_init_code_msb(code)
    let lsb = regi2c_p4_init_code_lsb(code)
    if unit == 1 {
        regi2c_sar_write_mask_p4(1, 3, 0, msb)
        regi2c_sar_write_mask_p4(0, 7, 0, lsb)
        return
    }
    regi2c_sar_write_mask_p4(4, 3, 0, msb)
    regi2c_sar_write_mask_p4(3, 7, 0, lsb)
}

/// Connect (`en!=0`) or disconnect internal GND for ADC `unit` (1 or 2).
/// Out of range → no MMIO.
pub fn adc_cal_encal_gnd_p4(unit: i32, en: i32) {
    if adc_cal_p4_unit_ok(unit) == 0 {
        return
    }
    let mut bit = 5
    if unit == 2 {
        bit = 7
    }
    let mut v = 0
    if en != 0 {
        v = 1
    }
    regi2c_sar_write_mask_p4(7, bit, bit, v)
}
