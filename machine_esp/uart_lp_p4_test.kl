module machine_esp

import testing

fn test_uart_lp_p4_base_and_sig() {
    testing.assert_eq_i32(uart_lp_p4_base(), 0x50121000)
    testing.assert_eq_i32(uart_lp_p4_sig(), 2)
    testing.assert_eq_i32(uart_lp_p4_fifo_len(), 16)
}

fn test_uart_lp_p4_clock_bits() {
    testing.assert_eq_i32(uart_lp_p4_clk_en_bit(), 29)
    testing.assert_eq_i32(uart_lp_p4_rst_bit(), 28)
    testing.assert_eq_i32(uart_lp_p4_clk_sel_xtal_d2(), 1)
}

fn test_uart_lp_p4_fifo_fields() {
    testing.assert_eq_i32(uart_lp_p4_rxfifo_shift(), 3)
    testing.assert_eq_i32(uart_lp_p4_txfifo_shift(), 19)
    testing.assert_eq_i32(uart_lp_p4_fifo_mask(), 31)
    testing.assert_eq_i32(uart_lp_p4_rxfifo_cnt(0), 0)
    testing.assert_eq_i32(uart_lp_p4_rxfifo_cnt(1 << 3), 1)
    testing.assert_eq_i32(uart_lp_p4_rxfifo_cnt(16 << 3), 16)
    testing.assert_eq_i32(uart_lp_p4_txfifo_cnt(0), 0)
    testing.assert_eq_i32(uart_lp_p4_txfifo_cnt(1 << 19), 1)
    testing.assert_eq_i32(uart_lp_p4_txfifo_cnt(15 << 19), 15)
}

fn test_uart_lp_p4_clkdiv_xtal_d2() {
    testing.assert_eq_i32(uart_clkdiv_int(20000000, 115200), 173)
    testing.assert_eq_i32(uart_clkdiv_frag(20000000, 115200), 9)
    testing.assert_eq_i32(uart_clkdiv_int(20000000, 9600), 2083)
    testing.assert_eq_i32(uart_clkdiv_frag(20000000, 9600), 13)
}
