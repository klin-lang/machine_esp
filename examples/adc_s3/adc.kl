// ESP32-S3 ADC1 CH0 = GPIO1 → LEDC PWM brightness on GPIO2.
// Channel map: CH0→GPIO1 … CH9→GPIO10 (see adc_s3.kl).
import "../../machine_esp" machine

@[cexport, codename("klin_app_main")]
fn adc_main() {
    let adc = machine.adc_out_s3(1, 0)
    let led = machine.pwm_out_s3(2, 0, 0, 80000000)
    led.freq(1000)
    while true {
        led.duty_u16(adc.read_u16())
    }
}

fn main() {
    adc_main()
}
