// ESP32-P4 I2C0: SDA=GPIO8 / SCL=GPIO9, XTAL 40 MHz, 100 kHz.
// Configures the bus then blinks GPIO2 via pin_out_p4.
import "../../machine_esp" machine

@[cexport, codename("klin_app_main")]
fn i2c_main() {
    let bus = machine.i2c_out_p4(0, 8, 9, 40000000, 100000)
    let led = machine.pin_out_p4(2)
    while true {
        led.toggle()
        let mut i: i32 = 0
        while i < 2000000 {
            i = i + 1
        }
        if false {
            bus.deinit()
        }
    }
}

fn main() {
    i2c_main()
}
