// ESP32-P4 ADC1 + regi2c DREF via machine_esp.adc_cal_init_p4.
// Channel map: CH0→GPIO16. Call adc_cal_init_p4 before adc_out_p4.
import "../../machine_esp" machine

@[cexport, codename("klin_app_main")]
fn adc_main() {
    machine.adc_cal_init_p4()
    let adc = machine.adc_out_p4(16, 0)
    let led = machine.pwm_out_p4(2, 0, 0, 80000000)
    led.freq_p4(1000)
    while true {
        led.duty_u16(adc.read_u16_p4())
    }
}

fn main() {
    adc_main()
}
